#include <bits/stdc++.h>
using namespace std;

#define MOD 998244353

int main() {
    int a;
    cin >> a;

    while (a--) {
        int c;
        cin >> c;

        vector<int> e(c + 2, 0);

        for (int g = 0; g < c; g++) {
            int i;
            cin >> i;
            e[i]++;
        }

        vector<long long> k(c + 2, 0);

        for (int g = 0; g <= c + 1; g++) {
            k[g] = 1;

            for (int i = 0; i < e[g]; i++)
                k[g] = k[g] * 2 % MOD;

            k[g] = (k[g] - 1 + MOD) % MOD;
        }

        long long m = k[1];
        long long n = 1;

        for (int g = 1; g <= c; g++) {
            if (e[g - 1] == 0)
                break;

            n = n * k[g - 1] % MOD;

            // mex = g, max = g - 1
            m = (m + n) % MOD;

            // mex = g, max = g + 1
            if (g + 1 <= c)
                m = (m + n * k[g + 1]) % MOD;
        }

        cout << m << '\n';
    }

    return 0;
}