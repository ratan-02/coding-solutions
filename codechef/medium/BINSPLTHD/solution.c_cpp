#include <bits/stdc++.h>
using namespace std;

map<string, string> dp;

bool check(string s) {
    return (s.find('0') != string::npos) && (s.find('1') != string::npos);
}

string solve(string s) {
    if (dp.count(s)) return dp[s];
    
    vector<string> nxt;
    for (int i = 0; i < s.length() - 1; i++) {
        if (s[i] == s[i+1]) continue;
        
        string pref = s.substr(0, i + 1);
        string suff = s.substr(i + 1);
        
        if (check(pref)) nxt.push_back(pref);
        if (check(suff)) nxt.push_back(suff);
    }
    
    if (nxt.empty()) {
        dp[s] = s;
        return s;
    }
    
    string mn = s;
    for (auto& x : nxt) {
        string res = solve(x);
        if (res < mn) mn = res;
    }
    
    dp[s] = mn;
    return mn;
}

int main() {
    ios_base::sync_with_stdio(false); 
    cin.tie(NULL);
    
    int t;
    cin >> t;
    
    while (t--) {
        int n;
        string s;
        cin >> n >> s;
        
        dp.clear();
        string mx = solve(s);
        
        for (int i = 0; i < n; i++) {
            string cur = s;
            for (int j = i; j < n; j++) {
                if(cur[j] == '0') cur[j] = '1';
                else cur[j] = '0';
                
                dp.clear();
                string temp = solve(cur);
                
                if (temp > mx) {
                    mx = temp;
                }
            }
        }
        
        cout << mx << "\n";
    }
    
    return 0;
}