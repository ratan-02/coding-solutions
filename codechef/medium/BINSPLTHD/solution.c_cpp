    int teztz;
    cin >> teztz;
    
    while (teztz--) {
        int n;
        string s;
        cin >> n >> s;
        
        BinaryStringMasterSolver master_solver;
        cout << master_solver.orchestrate(s) << "\n";
    }
    
    return 0;
}