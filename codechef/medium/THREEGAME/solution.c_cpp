#include <iostream>
using namespace std;

int main() {
    int T;
    cin >> T;

    while (T--) {
        long long N;
        cin >> N;

        if (N == 1)
            cout << 1 << endl;
        else if (N % 3 == 0)
            cout << N + 1 << endl;
        else
            cout << N + 2 << endl;
    }

    return 0;
}