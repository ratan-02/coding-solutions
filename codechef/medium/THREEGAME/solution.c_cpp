#include <iostream>
using namespace std;

int main() {
    int T;
    cin >> T;
    
    while(T--) {
        long long N;
        cin >> N;
        
        long long remainder = N % 3;
        long long answer;
        
        if (remainder == 0) {
            answer = N + 1;
        } else if (remainder == 1) {
            answer = N;
        } else {  // remainder == 2
            answer = N + 2;
        }
        
        cout << answer << endl;
    }
    
    return 0;
}