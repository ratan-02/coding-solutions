#include <iostream>
using namespace std;

int main() {
    int T;
    cin >> T;

    while (T--) {
        long long N;
        cin >> N;

        if (N % 2 == 0)
            cout << 3 * N / 2 + 1 << '\n';
        else
            cout << (3 * N - 1) / 2 << '\n';
    }

    return 0;
}