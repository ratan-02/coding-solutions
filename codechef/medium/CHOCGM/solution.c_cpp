#include <bits/stdc++.h>
using namespace std;

int main() {
	int t;
	cin>> t;
	while(t--){
	    int n;
	    cin >> n;
	    int sum = 0;
	    bool odd = false;
	    for(int i = 0; i < n; i++){
	        int x;
	        cin>> x;
	        sum = sum+x;
	        if(x%2!=0){
	            odd= true;
	        }
	    }
	        if(sum%2 !=0){
	            cout << 0 << endl;
	        }
	        else if(odd){
	            cout << sum-1 <<endl;
	        }
	        else{
	            cout<< sum<< endl;
	        }
	    
	}
	return 0;
}
