#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);
	int t;
	cin>> t;
	while(t--){
	    int n;
	    cin >> n;
	    int sum = 0, ob = 0;
	    for(int i = 0; i < n; i++){
	        int x;
	        cin>> x;
	        sum = sum+x;
	        ob += (x%2);
	    }
	    if(sum%2==0){
	    cout << sum -ob/2 << endl;
	    }
	    else{
	        cout << ob/2 << endl;
	    }
	}
	return 0;
}
