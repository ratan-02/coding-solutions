#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int x;
    cin >> x;

    while (x--) {
        int n;
        cin >> n;

        vector<long long> a(n);

        for (int i = 0; i < n; i++) {
            cin >> a[i];
        }

        string s;
        cin >> s;

        int p = 0;

        for (int i = 1; i < n; i++) {
            if (a[i] > a[p]) {
                p = i;
            }
        }

        int z = 0, q = 0;

        for (int i = 0; i < n; i++) {
            int j = (i + 1) % n;

            if (s[i] != s[j]) {
                if (s[i] == '0')
                    z++;
                else
                    q++;
            }
        }

        int b0 = 0, b1 = 0;
        long long ans = 0;

        for (int k = 1; k < n; k++) {
            int id = (p + k - 1) % n;
            int nx = (id + 1) % n;

            if (s[id] != s[nx]) {
                if (s[id] == '0')
                    b0++;
                else
                    b1++;
            }

            int c0 = z - b0;
            int c1 = q - b1;

            bool ok = false;

            if (b0 > 0 && c1 > 0)
                ok = true;

            if (b1 > 0 && c0 > 0)
                ok = true;

            int pos = (p + k) % n;

            if (ok) {
                ans = max(ans, a[pos]);
            }
        }

        cout << a[p] + ans << '\n';
    }

    return 0;
}