#include <bits/stdc++.h>
using namespace std;

int main() {
    int x;
    cin >> x;

    while (x--) {
        int n;
        string a;

        cin >> n >> a;

        int z = 0;
        int b = 0;

        for (int i = 0; i < n - 1; i++) {
            if (a[i] == a[i + 1])
                z++;
            else
                b++;
        }

        int ans = z + min(2, max(0, b - 1));

        cout << ans << endl;
    }

    return 0;
}