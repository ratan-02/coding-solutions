#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int T;
    cin >> T;

    while (T--) {
        int N;
        cin >> N;

        vector<long long> A(N);

        for (auto &x : A)
            cin >> x;

        long long ans = abs(A[0]) + abs(A[N - 1]);

        for (int i = 1; i < N; i++)
            ans += abs(A[i] + A[i - 1]);

        cout << ans / 2 << endl;
    }

    return 0;
}