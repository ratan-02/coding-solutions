#include <bits/stdc++.h>
using namespace std;

int main() {
	int t;
	while(t--){
	    int p;
	    cin >> p;
	    if(p%3== 0){
	        cout <<0 << endl;
	    }
	    else if((p+1)%3 ==0){
	        cout <<1<< endl;
	    }
	    else{
	        int x =(p/5 + 1)*5;
	        if(x%3 == 0){
	           cout << 1 <<endl; 
	        }
	        else{
	            cout << 2<< endl;
	        }
	    }
	}
	return 0;
}
