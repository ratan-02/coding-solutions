#include <bits/stdc++.h>
using namespace std;

int main() {
    int x;
    cin >> x;

    while (x--) {
        int a;
        cin >> a;

        vector<int> z(a);

        for (int b = 0; b < a; b++) {
            cin >> z[b];
        }

        int ans = 0;

        for (int i = 0; i < a; i++) {
            ans = max(ans, z[i]);

            for (int j = i + 1; j < a; j++) {
                if (z[i] <= z[j]) {
                    ans = max(ans, z[i] + z[j]);
                }
            }
        }

        cout << ans << endl;
    }

    return 0;
}