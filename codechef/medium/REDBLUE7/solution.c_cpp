#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;

    while (t--) {
        int n;
        cin >> n;

        long long sum = 0, mx = 0;

        for (int z = 0; z < n; z++) {
            long long v;
            cin >> v;

            sum += v;
            mx = max(mx, v);
        }

        cout << sum + mx * (n - 2) << '\n';
    }

    return 0;
}