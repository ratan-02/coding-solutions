#include <bits/stdc++.h>
using namespace std;

int main() {
    int T;
    cin >> T;

    while (T--) {
        int X;
        string S;

        cin >> X >> S;

        int carlsen = 0, chef = 0;

        for (char c : S) {
            if (c == 'C') {
                carlsen += 2;
            } 
            else if (c == 'N') {
                chef += 2;
            } 
            else {
                carlsen++;
                chef++;
            }
        }

        if (carlsen > chef)
            cout << 60 * X << endl;
        else if (carlsen == chef)
            cout << 55 * X << endl;
        else
            cout << 40 * X << endl;
    }

    return 0;
}